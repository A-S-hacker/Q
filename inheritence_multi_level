using System;

class Animal
{
    public void Eat()
    {
        Console.WriteLine("Animal is eating..");
    }
}

class Dog: Animal
{
    public void Bark()
    {
        Console.WriteLine("Dog is Barking...");
    }
}

class Puppy: Dog
{
    public void Playing()
    {
        Console.WriteLine("Puppy is playing");
    }
}

class Program
{
    public static void Main()
    {
        Puppy p = new Puppy();
        p.Playing();
        p.Bark();
        p.Eat();
    }
}
