using System;

class week
{
    public void week_days()
    {
        Console.WriteLine("Enter 1-7 number: ");
        int week = int.Parse(Console.ReadLine());
        switch (week)
        {
            case 1:
                Console.WriteLine("Monday");
                break;

            case 2:
                Console.WriteLine("Tuesday");
                break;
            case 3:
                Console.WriteLine("Wednesday");
                break;
            case 4:
                Console.WriteLine("Thusday");
                break;
            case 5:
                Console.WriteLine("Friday");
                break;
            case 6:
                Console.WriteLine("saturday");
                break;
            case 7:
                Console.WriteLine("SUnday");
                break;
            default:
                Console.WriteLine("Enter only between 1-7!");
                break;
        }

        
    }
    public static void Main()
    {
        week w = new week();
        w.week_days();
    }
}
