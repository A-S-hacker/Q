using System;

class Animal
{
    public void Eat()
    {
        Console.WriteLine("Animal is eating..");
    }
}

class Dog: Animal
{
    public void Bark()
    {
        Console.WriteLine("Dog is Barking...");
    }
}

class Cat: Animal
{
    public void Meow()
    {
        Console.WriteLine("Cat is Meowing");
    }
}

class Program
{
    public static void Main()
    {
        Dog d = new Dog();
        Cat c = new Cat();
        d.Eat();
        d.Bark();
        c.Eat();
        c.Meow();
    }
}
