using System;

class variables
{
    int a = 10;
    static int b = 20;
    public void add(int x, int y)
    {
        int c = x + y;
        Console.WriteLine("Addition of local variables is: " + c);
    }

    public static void Main()
    {
        variables v = new variables();
        Console.WriteLine("Global Variable: " + v.a);
        Console.WriteLine("Static Variable: " + variables.b);

        v.add(10, 20);
    }
}
